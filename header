<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="320" viewBox="0 0 1200 320" role="img" aria-label="Chinnawat Thongsuwan, AI Engineer">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0b1220"/>
      <stop offset="0.55" stop-color="#0f2a3a"/>
      <stop offset="1" stop-color="#145566"/>
    </linearGradient>
    <radialGradient id="glow" cx="0.82" cy="0.45" r="0.45">
      <stop offset="0" stop-color="#2dd4bf" stop-opacity="0.22"/>
      <stop offset="1" stop-color="#2dd4bf" stop-opacity="0"/>
    </radialGradient>
    <pattern id="dots" width="28" height="28" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1.2" fill="#ffffff" fill-opacity="0.06"/>
    </pattern>
    <clipPath id="card"><rect width="1200" height="320" rx="20"/></clipPath>
    <style>
      .t { font-family: 'Segoe UI', 'Helvetica Neue', Helvetica, Arial, sans-serif; }
      .m { font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace; }
      .up { animation: up 0.9s ease-out both; }
      .d1 { animation-delay: 0.15s; }
      .d2 { animation-delay: 0.3s; }
      .d3 { animation-delay: 0.45s; }
      .pulse { animation: pulse 3.2s ease-in-out infinite; }
      .p2 { animation-delay: 0.8s; }
      .p3 { animation-delay: 1.6s; }
      .flow { stroke-dasharray: 6 8; animation: flow 6s linear infinite; }
      @keyframes up { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
      @keyframes pulse { 0%, 100% { opacity: 0.55; } 50% { opacity: 1; } }
      @keyframes flow { to { stroke-dashoffset: -140; } }
    </style>
  </defs>

  <g clip-path="url(#card)">
    <rect width="1200" height="320" fill="url(#bg)"/>
    <rect width="1200" height="320" fill="url(#dots)"/>
    <rect width="1200" height="320" fill="url(#glow)"/>

    <!-- neural network motif -->
    <g stroke="#5eead4" stroke-opacity="0.35" stroke-width="1.5" fill="none">
      <path class="flow" d="M900 90 L1000 60 M900 90 L1000 160 M900 160 L1000 60 M900 160 L1000 160 M900 160 L1000 255 M900 230 L1000 160 M900 230 L1000 255"/>
      <path class="flow" d="M1000 60 L1100 110 M1000 160 L1100 110 M1000 160 L1100 210 M1000 255 L1100 210"/>
    </g>
    <g fill="#0f2a3a" stroke="#5eead4" stroke-width="2">
      <circle class="pulse" cx="900" cy="90" r="9"/>
      <circle class="pulse p2" cx="900" cy="160" r="9"/>
      <circle class="pulse p3" cx="900" cy="230" r="9"/>
      <circle class="pulse p2" cx="1000" cy="60" r="11"/>
      <circle class="pulse p3" cx="1000" cy="160" r="11"/>
      <circle class="pulse" cx="1000" cy="255" r="11"/>
      <circle class="pulse p3" cx="1100" cy="110" r="13"/>
      <circle class="pulse" cx="1100" cy="210" r="13"/>
    </g>
    <circle cx="1100" cy="110" r="4" fill="#5eead4"/>
    <circle cx="1100" cy="210" r="4" fill="#5eead4"/>

    <!-- accent bar -->
    <rect x="72" y="92" width="44" height="4" rx="2" fill="#5eead4" class="up"/>

    <text x="72" y="80" class="m up" font-size="17" letter-spacing="4" fill="#5eead4">AI ENGINEER</text>
    <text x="70" y="160" class="t up d1" font-size="60" font-weight="700" fill="#ffffff">Chinnawat Thongsuwan</text>
    <text x="72" y="206" class="t up d2" font-size="23" fill="#cbd5e1">Agentic RAG  ·  ML Serving &amp; Optimization  ·  MLOps</text>
    <text x="72" y="256" class="m up d3" font-size="16" fill="#94a3b8">B.Eng. AI Engineering &amp; Data Science  —  Bangkok, Thailand</text>
  </g>
</svg>
